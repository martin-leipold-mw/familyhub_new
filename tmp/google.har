            "mimeType": "text/javascript",
            "text": "import { startOfWeek, startOfDay, endOfDay, addDays, format, isSameDay } from \"/node_modules/.vite/deps/date-fns.js?v=033d1d9a\";\nimport { de } from \"/node_modules/.vite/deps/date-fns_locale.js?v=033d1d9a\";\nexport function weekDays(anchor) {\n    const monday = startOfWeek(anchor, {\n        weekStartsOn: 1\n    });\n    return Array.from({\n        length: 7\n    }, (_, i)=>addDays(monday, i));\n}\nexport function visibleRange(anchor, view) {\n    if (view === 'day') {\n        return {\n            start: startOfDay(anchor),\n            end: endOfDay(anchor)\n        };\n    }\n    const days = weekDays(anchor);\n    return {\n        start: startOfDay(days[0]),\n        end: endOfDay(days[6])\n    };\n}\nexport function shiftAnchor(anchor, view, dir) {\n    return view === 'day' ? addDays(anchor, dir) : addDays(anchor, dir * 7);\n}\nexport function agendaRange(today, days = 30) {\n    return {\n        start: startOfDay(today),\n        end: endOfDay(addDays(today, days))\n    };\n}\nexport function rangeParams(range) {\n    return {\n        start: range.start.toISOString(),\n        end: range.end.toISOString()\n    };\n}\nexport function periodLabel(anchor) {\n    return format(anchor, 'MMMM yyyy', {\n        locale: de\n    });\n}\nexport function weekdayHeader(day) {\n    return format(day, 'EEEEEE dd', {\n        locale: de\n    });\n}\nexport function dayNumber(day) {\n    return format(day, 'd');\n}\nexport function isSameDayAs(a, b) {\n    return isSameDay(a, b);\n}\nexport function formatTime(d) {\n    return format(d, 'HH:mm');\n}\nexport function allDaySpansDay(start, end, day) {\n    const key = format(day, 'yyyy-MM-dd');\n    if (!end) return key === start;\n    return key >= start && key < end;\n}\n\n//# sourceMappingURL=data:application/json;base64,"
